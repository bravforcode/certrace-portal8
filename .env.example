# Local Compose defaults. Use unique secrets and HTTPS for deployments.
# Required: compose refuses to start until these are set.
POSTGRES_PASSWORD=
DATABASE_PORT=55432
BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
CERTRACE_JWT_SECRET=
CERTRACE_GOOGLE_CLIENT_ID=
CERTRACE_SHEET_WEBHOOK_URL=
CERTRACE_JOBS_TOKEN=
# Production requires an https URL here (assertProductionConfig enforces it).
# compose maps APP_BASE_URL to CERTRACE_APP_BASE_URL for the backend container.
CERTRACE_APP_BASE_URL=http://localhost:3000
# console (development only, logs mail) | resend | smtp | off
CERTRACE_EMAIL_DELIVERY=console
CERTRACE_EMAIL_SENDER=
RESEND_API_KEY=
# CERTRACE_EMAIL_DELIVERY=smtp uses these instead of RESEND_API_KEY
CERTRACE_SMTP_HOST=
CERTRACE_SMTP_PORT=587
CERTRACE_SMTP_USER=
CERTRACE_SMTP_PASSWORD=
CERTRACE_SUPPLIER_EMAILS=0
# Optional legacy evidence extraction on monthly document attachments.
ANTHROPIC_API_KEY=
# Optional Cera chat. Leave blank to keep the rule-based assistant.
DEEPSEEK_API_KEY=
CERTRACE_CERA_MODEL=deepseek-flash
# DeepSeek OCR 2 is hosted by Novita; report field mapping reuses DEEPSEEK_API_KEY.
NOVITA_API_KEY=
CERTRACE_OCR_MODEL=deepseek/deepseek-ocr-2
CERTRACE_AUTOFILL_MODEL=deepseek-flash
# database | r2. R2 remains private; the backend authorizes every download.
CERTRACE_FILE_STORAGE=database
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Document mapping: bounded output, cached results and no automatic paid retries.
CERTRACE_AUTOFILL_DAILY_LIMIT=40
CERTRACE_AUTOFILL_GLOBAL_DAILY_LIMIT=200

# Only enable behind proxies that sanitize/append X-Forwarded-For; see PROJECT.md.
CERTRACE_TRUSTED_PROXY_HOPS=0
