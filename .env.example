# คอนฟิกสำหรับการส่งอีเมลของสคริปต์ send_emails.py ผ่าน Resend API
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขข้อมูลด้านล่างให้ถูกต้อง

# คีย์ API ของ Resend (สร้างได้จาก Dashboard ของ Resend เมนู API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# อีเมลผู้ส่ง (ต้องเป็นโดเมนที่ Verify ผ่าน DNS Cloudflare บน Resend แล้ว)
# เช่น Thanakit Inkaew <thanakit@yourdomain.com> หรือ thanakit@yourdomain.com
SENDER_EMAIL=thanakit@yourdomain.com

# (ทางเลือก) ลิงก์ URL ของโลโก้บริษัท ต้องเป็นลิงก์ภาพแบบสาธารณะ (PNG หรือ JPG เท่านั้น)
# ตัวอย่าง: LOGO_URL=https://certrace.co/brand/logo.png
LOGO_URL=

# (ทางเลือก) ลิงก์ Google Sheets สำหรับดึงข้อมูลส่งอีเมล (แทนไฟล์ CSV โลคอล)
# ตัวอย่าง: GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1bg2Jp2A0pplgzBhB0-yE-lCeccg6aU6CICD5H7vL3yE/edit?gid=1627485250#gid=1627485250
GOOGLE_SHEET_URL=
