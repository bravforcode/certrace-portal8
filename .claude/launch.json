{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "certrace-backend",
      "runtimeExecutable": "C:/Users/menum/.bun/bin/bun.exe",
      "runtimeArgs": ["--cwd", "C:/Certrace/certrace-portal8/certrace-backend", "--watch", "src/index.ts"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "certrace-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "certrace-portal", "run", "dev"],
      "port": 3000
    },
    {
      "name": "certrace-portal-turbo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "certrace-portal", "run", "dev", "--", "--turbopack"],
      "port": 3000
    },
    {
      "name": "certrace-portal-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--cwd", "certrace-portal", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "certrace-exporter-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "certrace-exporter-portal", "run", "dev", "--", "--port", "3007"],
      "port": 3007
    }
  ]
}
