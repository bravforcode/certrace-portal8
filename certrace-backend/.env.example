# Supabase pooled PostgreSQL connection URI.
# Copy this file to .env and replace the placeholder locally. Do not commit .env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Keep the total below the Supabase pooler's connection limit:
# max Cloud Run instances * (pool size + max overflow).
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0

# Production safety gates. Cloud Run should require persistent storage and
# should not expose interactive API documentation by default. Both default to
# the safe setting when unset; set CERTRACE_ENABLE_API_DOCS=1 only where the
# interactive docs are wanted (a staging box), never in production.
CERTRACE_REQUIRE_DATABASE=false
CERTRACE_ENABLE_API_DOCS=false

# Optional comma-separated allowlist for browser clients.
# Use exact origins only. Production origins must use HTTPS.
CERTRACE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Outbound email (Resend). Leave the key unset and delivery stays off: the
# app runs, and every notification is dropped with a warning in the log.
#   resend  - send for real. Needs both the key and the sender.
#   console - render the message into the log, including the reset code.
#             The way to test a password reset locally with no key.
#   off     - discard. The default when no key is configured.
CERTRACE_EMAIL_DELIVERY=off
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# Must be on a domain verified in Resend, or every send fails with a 403.
CERTRACE_EMAIL_SENDER=Certrace <contact@certrace.co>
CERTRACE_EMAIL_REPLY_TO=contact@certrace.co

# Optional public PNG/JPG shown at the top of each email. Omitted = no logo.
CERTRACE_EMAIL_LOGO_URL=

# Signing key for the portal session tokens (HS256). Required whenever a
# DATABASE_URL is set: the app refuses to start without it rather than sign
# with a key that changes on every restart, which would log everyone out.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CERTRACE_JWT_SECRET=replace-me-with-a-generated-secret

# Where minted supplier smart links point (the portal serving /s/<token>).
# Unset = https://app.certrace.co. Set to http://localhost:3000 locally.
CERTRACE_APP_BASE_URL=
