# Supabase pooled PostgreSQL connection URI.
# Copy this file to .env and replace the placeholder locally. Do not commit .env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional comma-separated allowlist for browser clients.
# Use exact origins only. Production origins must use HTTPS.
CERTRACE_CORS_ALLOWED_ORIGINS=http://localhost:3000
