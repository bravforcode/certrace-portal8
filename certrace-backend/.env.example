# Bun development environment; root .env.example configures Docker Compose.
DATABASE_URL=postgresql://certrace:certrace-local@localhost:55432/certrace
PORT=8000
CERTRACE_APP_BASE_URL=http://localhost:3000
CERTRACE_CORS_ALLOWED_ORIGINS=http://localhost:3000
CERTRACE_JWT_SECRET=local-development-change-before-deployment
COOKIE_SECURE=false
CERTRACE_ENABLE_API_DOCS=true
CERTRACE_GOOGLE_CLIENT_ID=
CERTRACE_SHEET_WEBHOOK_URL=
CERTRACE_EMAIL_SENDER=
RESEND_API_KEY=
CERTRACE_SUPPLIER_EMAILS=0
ANTHROPIC_API_KEY=
# Optional Cera chat. Leave blank to keep the rule-based assistant.
DEEPSEEK_API_KEY=
CERTRACE_CERA_MODEL=deepseek-flash
NOVITA_API_KEY=
CERTRACE_OCR_MODEL=deepseek/deepseek-ocr-2
CERTRACE_AUTOFILL_MODEL=deepseek-flash
CERTRACE_EXTRACTION_MODEL=claude-haiku-5-5
CERTRACE_AUTOFILL_DAILY_LIMIT=40
CERTRACE_AUTOFILL_GLOBAL_DAILY_LIMIT=200
