{
  "name": "@certrace/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:report-catalogue": "bun scripts/generate-report-storage.ts --check && bun scripts/generate-autofill-reference.ts --check",
    "db:report-backfill": "bun scripts/migrate-report-data.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.75",
    "@ai-sdk/openai-compatible": "3.0.80",
    "@anthropic-ai/sdk": "^0.116.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.0",
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@zip.js/zip.js": "2.24.0",
    "ai": "^7.0.156",
    "decimal.js": "^10.6.0",
    "elysia": "1.4.30",
    "exceljs": "4.4.0",
    "jose": "^6.1.0",
    "jszip": "^3.10.2",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "6.2.108",
    "pg": "^8.16.3",
    "prisma": "7.10.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.6",
    "pdf-lib": "1.17.1",
    "typescript": "^5.9.3"
  }
}
