# Copy to .env.local for development. .env*.local is gitignored — do not commit it.

# Where the FastAPI backend answers.
#
# LEAVE IT BLANK to run the portal exactly as it does today: every store reads
# and writes localStorage, no request leaves the browser, and the demo works on
# a laptop with no backend running. `apiConfigured()` in lib/api/config.ts is
# what reads this, and every migrated store falls back when it is empty.
#
# Set it to point the portal at a real backend:
#   local dev    http://localhost:8000
#   production   https://api.certrace.co
#
# Whatever value goes here must also appear in the backend's
# CERTRACE_CORS_ALLOWED_ORIGINS, or the browser blocks the response.
#
# This value is also what puts the backend's origin into the Content-Security-
# Policy (middleware.ts, and scripts/build-csp-headers.mjs for the prerendered
# pages). Change it here and both follow; hardcode the origin in either of
# those and they drift apart the next time this moves.
NEXT_PUBLIC_API_BASE_URL=

# Let the portal SIMULATE a backend when NEXT_PUBLIC_API_BASE_URL is blank.
#
# The simulated path is what makes the demo work: sign in with any address and
# password, fake the reset email, resolve smart links from bundled fixtures.
# `next dev` turns it on by itself, so a laptop with no .env.local behaves
# exactly as it always has and this line is not needed there.
#
# It exists for a DEPLOYED demo. Leaving it off is what stops a production
# build that simply has no backend yet from handing the portal to anyone who
# types something into /login — which is what portal.certrace.co did until
# demoModeEnabled() in lib/api/config.ts started asking this question.
#
# Set to exactly "1" to turn it on. Never set it on the production deployment.
NEXT_PUBLIC_DEMO_MODE=

# Sign in with Google: the OAuth client id (…apps.googleusercontent.com).
# The backend's CERTRACE_GOOGLE_CLIENT_ID must be the SAME id — it is the
# audience every Google ID token is checked against. Blank hides the button;
# it also stays hidden while NEXT_PUBLIC_API_BASE_URL is blank, since nothing
# could verify Google's answer. The OAuth client must list
# <portal origin>/auth/google as an authorized redirect URI.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
