# Copy to .env beside docker-compose.yml and Caddyfile on the VPS.
# docker-compose.yml is the server copy of docker-compose-prod.yml.
COMPOSE_FILE=docker-compose.yml
# Use long random URL-safe values (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=
CERTRACE_JWT_SECRET=
APP_BASE_URL=https://portal.certrace.co
COOKIE_SECURE=true
FRONTEND_PORT=3000
BACKEND_PORT=8000

IMAGE_PREFIX=ghcr.io/mikaoverdose/ceatrace
# latest, or sha-<full Git commit SHA> to pin all three images to one release.
IMAGE_TAG=latest

# Configure the same Google client ID as the GitHub Actions repository variable
# CERTRACE_GOOGLE_CLIENT_ID used to build the frontend image.
CERTRACE_GOOGLE_CLIENT_ID=
CERTRACE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyPdRpxCS8PaLklVLW4ga6UC097xz_NLZo5CkfhSj2HuOhvX_3c_dP6XTBsUsw9z-uA/exec
CERTRACE_JOBS_TOKEN=
CERTRACE_SUPPLIER_EMAILS=0
CERTRACE_EMAIL_DELIVERY=off
CERTRACE_EMAIL_SENDER=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
# Optional Cera chat. Leave blank to keep the rule-based assistant.
DEEPSEEK_API_KEY=
CERTRACE_CERA_MODEL=deepseek-flash
NOVITA_API_KEY=
CERTRACE_OCR_MODEL=deepseek/deepseek-ocr-2
CERTRACE_AUTOFILL_MODEL=deepseek-flash
# Set r2 after creating a private bucket and bucket-scoped S3 credentials.
CERTRACE_FILE_STORAGE=database
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Only enable behind proxies that sanitize/append X-Forwarded-For; see PROJECT.md.
CERTRACE_TRUSTED_PROXY_HOPS=0
