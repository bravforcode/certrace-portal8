{
  "name": "certrace-compliance2",
  "version": "0.1.0",
  "private": true,
  "description": "Certrace — Legal / Compliance seat portal. The exporter portal scoped to the seat that ASSURES the filing rather than building it: reads everything, reviews and sends months back, corrects a figure that is wrong, signs the finished pack off. Creates no workspaces, chases no suppliers, archives nothing, no billing, no seats. See lib/seat.ts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build-pages": "next-on-pages && echo _worker.js > .vercel/output/static/.assetsignore",
    "start": "next start",
    "lint": "next lint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-resolver.mjs --test \"lib/**/__tests__/**/*.test.ts\"",
    "stress-test:pdf": "tsx scripts/stress-test-pdf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.456.0",
    "next": "^15.5.20",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  }
}
